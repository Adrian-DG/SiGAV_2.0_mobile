# API a la que se conecta la app. Elegir el ambiente al arrancar:
#   npm run start:local | npm run start:tunnel | npm run start:prod
# Sin elegir: local en desarrollo, production en builds de release.
# EXPO_PUBLIC_API_ENV=local

# --- local: esta PC, puerto HTTP de Presentation (5282) ---
# IP de esta máquina en la LAN; necesaria para emulador/dispositivo físico (localhost en ellos
# sería el propio dispositivo). La API debe escuchar en la red y no solo en localhost:
#   dotnet run --launch-profile http --urls http://0.0.0.0:5282
EXPO_PUBLIC_API_URL_LOCAL=http://10.0.0.5:5282/api

# --- dev_tunnel: Dev Tunnel de Visual Studio (puerto HTTPS 7148) ---
# Cambia si el túnel es temporal y se reinicia Visual Studio.
EXPO_PUBLIC_API_URL_DEV_TUNNEL=https://vx0xf1bq-7148.use2.devtunnels.ms
# Solo si el túnel es Privado u Organización ("Copy Tunnel Access Token"). No hace falta: el
# túnel actual responde sin token (es Público).
# EXPO_PUBLIC_DEV_TUNNEL_TOKEN=

# --- production: API publicada ---
# Sin valor todavía — no hay URL de producción real. Debe ser https.
# EXPO_PUBLIC_API_URL_PRODUCTION=
