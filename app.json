{
  "expo": {
    "name": "SiGAV Móvil",
    "slug": "sigav-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigav",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.sigavmovil"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05539B",
          "image": "./assets/images/brand/comipol-crest.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#05539B"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SiGAV Móvil usa tu ubicación para registrar dónde ocurre cada evento atendido por la unidad y mostrar la unidad en el mapa del centro de control.",
          "locationAlwaysAndWhenInUsePermission": "Durante el turno, SiGAV Móvil comparte la ubicación de la unidad con el centro de control aunque la pantalla esté bloqueada. Deja de enviarla al cerrar sesión.",
          "locationAlwaysPermission": "Durante el turno, SiGAV Móvil comparte la ubicación de la unidad con el centro de control aunque la pantalla esté bloqueada. Deja de enviarla al cerrar sesión.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SiGAV Móvil usa la cámara para escanear la cédula del ciudadano y la placa del vehículo."
        }
      ],
      "./plugins/with-mlkit-ocr"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
