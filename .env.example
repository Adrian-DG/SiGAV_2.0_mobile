# Base URL of the SiGAV API (Presentation project), including /api.
# - Android emulator reaching a host machine: http://10.0.2.2:5282/api
# - Physical device / iOS simulator: http://<your-lan-ip>:5282/api
# Copy this file to .env.local and adjust before running the app.
EXPO_PUBLIC_API_URL=http://localhost:5282/api
